{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaStamp",
  "version": "0.1.0",
  "identifier": "io.github.cuplyk.metastamp",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MetaStamp",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Edit Office document dates and file timestamps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
